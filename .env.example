# ──────────────────────────────────────────────────────────────
# B2B Wholesale Portal — Environment Template
# Copy to .env and fill real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PLATFORM_DOMAIN=app.example.com
INTERNAL_API_SECRET=replace-with-64-char-random-hex

# ── Database (Supabase PostgreSQL 16 + built-in PgBouncer) ────
# Pooled transaction-mode connection used by the app at runtime (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Direct connection used only by Prisma Migrate (port 5432, bypasses PgBouncer).
DATABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Redis (TWO separate instances) ────────────────────────────
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# ── Shopify OAuth ─────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,write_orders,read_orders,read_customers
SHOPIFY_APP_URL=https://app.example.com

# ── Authentication (Clerk — BUYER portal only) ───────────────
# Clerk owns buyer identity. Merchants use NextAuth + Shopify OAuth (below).
# Server-side keys (NestJS API + Clerk webhook verification):
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
# Browser-exposed key consumed by the Next.js buyer auth pages (ClerkProvider).
# MUST be the NEXT_PUBLIC_-prefixed copy or the client bundle cannot read it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ── Authentication (NextAuth — MERCHANT admin) ────────────────
# Used by the Next.js NextAuth route handler and edge middleware.
# NEXTAUTH_SECRET is the only var the dev-only "Demo Merchant Login" needs:
# in development a credentials provider mints a demo session that serves in-app
# sample data with no Shopify store and no backend. The demo provider/button are
# never present in a production build.
NEXTAUTH_SECRET=replace-with-32-char-random-secret
NEXTAUTH_URL=http://localhost:3000

# ── Web app public config (browser-exposed) ──────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Field encryption (AES-256-GCM, 32-byte keys, base64) ──────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY_V1=
# ENCRYPTION_KEY_V2= (add when rotating)
CURRENT_ENCRYPTION_KEY_VERSION=1

# ── AWS S3 (SSE-KMS) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=b2b-wholesale-invoices
S3_REGION=us-east-1
S3_KMS_KEY_ARN=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000

# ── Stripe (subscription + metered GMV) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_GROWTH_PRICE_ID=price_growth
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_GMV_METERED_PRICE_ID=price_gmv_metered

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=invoices@example.com

# ── BNPL (Resolve, US Phase 1) ────────────────────────────────
RESOLVE_API_KEY=
RESOLVE_WEBHOOK_SECRET=
RESOLVE_API_BASE_URL=https://app.resolvepay.com/api

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=

# ── CORS (comma-separated, never wildcard) ────────────────────
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── API server ────────────────────────────────────────────────
API_PORT=3001
