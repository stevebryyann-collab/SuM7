{
  "name": "b2b-wholesale-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify-embedded B2B wholesale operating system",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm dlx playwright@1.47.2 test",
    "test:load": "echo \"Run an individual scenario, e.g. k6 run tests/load/catalog.k6.js\" && exit 1",
    "db:generate": "pnpm --filter @b2b/database generate",
    "db:migrate": "pnpm --filter @b2b/database migrate",
    "db:seed": "pnpm --filter @b2b/database seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "typescript": "5.9.3"
  }
}
