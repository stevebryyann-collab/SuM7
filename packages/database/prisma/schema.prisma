// B2B Wholesale Portal — Prisma schema.
//
// Conventions:
//   - All primary keys are uuid, defaulted by Postgres `gen_random_uuid()`.
//   - Money is Decimal(15,2); never floats.
//   - Encrypted-at-rest columns are `text` holding the versioned AES-256-GCM
//     envelope (see packages/shared/src/utils/crypto.ts), paired with a
//     `*KeyVersion` smallint to support key rotation without re-reading the blob.
//   - Some indexes/constraints (GIN trigram, NULLS-NOT-DISTINCT, the audit_log
//     immutability trigger, RLS) cannot be expressed in PSL and live in the
//     raw SQL migrations under ../migrations.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm"), pgStatStatements(map: "pg_stat_statements")]
}

// ──────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  starter
  growth
  pro
}

enum MerchantUserRole {
  owner
  admin
  staff
}

enum PaymentTerms {
  immediate
  net15
  net30
  net60
  net90
}

enum ApprovalStatus {
  pending
  approved
  rejected
  suspended
}

enum PricingTierKind {
  percentage_off
  fixed_price_list
  volume_breaks
}

enum OrderStatus {
  pending
  confirmed
  fulfilled
  cancelled
}

enum OrderSyncStatus {
  synced
  shopify_orphan
  sync_pending
}

enum InvoiceStatus {
  draft
  sent
  viewed
  partially_paid
  paid
  overdue
  void
  defaulted
}

enum RegistrationStatus {
  pending
  approved
  rejected
}

enum WebhookStatus {
  pending
  processing
  processed
  failed
  dead_letter
}

enum AuditActorType {
  merchant_user
  buyer
  system
  shopify_webhook
  stripe_webhook
  bnpl_webhook
}

// ──────────────────────────────────────────────────────────────────────
// Core tenancy
// ──────────────────────────────────────────────────────────────────────

model Merchant {
  id                            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopifyDomain                 String           @unique @map("shopify_domain") @db.VarChar(255)
  shopifyAccessToken            String           @map("shopify_access_token") @db.Text
  shopifyAccessTokenKeyVersion  Int              @default(1) @map("shopify_access_token_key_version") @db.SmallInt
  shopifyStoreId                String?          @map("shopify_store_id") @db.VarChar(100)
  subscriptionTier              SubscriptionTier @default(starter) @map("subscription_tier")
  subscriptionStripeId          String?          @map("subscription_stripe_id") @db.VarChar(255)
  stripeCustomerId              String?          @map("stripe_customer_id") @db.VarChar(255)
  gmvCurrentMonth               Decimal          @default(0) @map("gmv_current_month") @db.Decimal(15, 2)
  gmvMonthKey                   String           @default("0000-00") @map("gmv_month_key") @db.Char(7)
  trialEndsAt                   DateTime?        @map("trial_ends_at") @db.Timestamptz(6)
  isActive                      Boolean          @default(true) @map("is_active")
  deletedAt                     DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt                     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  users         MerchantUser[]
  relationships MerchantBuyerRelationship[]
  pricingTiers  PricingTier[]
  orders        Order[]
  invoices      Invoice[]
  applications  BuyerRegistrationApplication[]

  @@index([subscriptionTier])
  @@map("merchants")
}

model MerchantUser {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String           @map("merchant_id") @db.Uuid
  clerkUserId String?          @unique @map("clerk_user_id") @db.VarChar(255)
  email       String           @db.VarChar(255)
  role        MerchantUserRole @default(staff)
  firstName   String?          @map("first_name") @db.VarChar(100)
  lastName    String?          @map("last_name") @db.VarChar(100)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant             Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  approvedRelationships MerchantBuyerRelationship[]   @relation("RelationshipApprover")
  reviewedApplications BuyerRegistrationApplication[] @relation("ApplicationReviewer")

  @@unique([merchantId, email])
  @@map("merchant_users")
}

// ──────────────────────────────────────────────────────────────────────
// Buyers (UNIFIED cross-merchant — NO merchant_id, NO RLS)
// ──────────────────────────────────────────────────────────────────────

model Buyer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  clerkUserId     String?   @unique @map("clerk_user_id") @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  companyName     String    @map("company_name") @db.VarChar(255)
  businessType    String?   @map("business_type") @db.VarChar(100)
  taxId           String?   @map("tax_id") @db.Text
  taxIdKeyVersion Int       @default(1) @map("tax_id_key_version") @db.SmallInt
  phone           String?   @db.Text
  phoneKeyVersion Int       @default(1) @map("phone_key_version") @db.SmallInt
  addressJson     Json?     @map("address_json")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  loginFailCount  Int       @default(0) @map("login_fail_count")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  anonymizedAt    DateTime? @map("anonymized_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  relationships MerchantBuyerRelationship[]
  orders        Order[]
  invoices      Invoice[]

  // GIN trigram index on company_name is created in migrations/001_extensions.sql
  @@map("buyers")
}

model MerchantBuyerRelationship {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String         @map("merchant_id") @db.Uuid
  buyerId        String         @map("buyer_id") @db.Uuid
  pricingTierId  String?        @map("pricing_tier_id") @db.Uuid
  paymentTerms   PaymentTerms   @default(immediate) @map("payment_terms")
  creditLimit    Decimal?       @map("credit_limit") @db.Decimal(15, 2)
  creditUsed     Decimal        @default(0) @map("credit_used") @db.Decimal(15, 2)
  creditVersion  Int            @default(0) @map("credit_version")
  approvalStatus ApprovalStatus @default(pending) @map("approval_status")
  notes          String?        @db.Text
  approvedBy     String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  buyer       Buyer         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  pricingTier PricingTier?  @relation(fields: [pricingTierId], references: [id], onDelete: SetNull)
  approver    MerchantUser? @relation("RelationshipApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([merchantId, buyerId])
  @@index([merchantId, approvalStatus])
  @@index([merchantId, pricingTierId])
  @@map("merchant_buyer_relationships")
}

// ──────────────────────────────────────────────────────────────────────
// Pricing
// ──────────────────────────────────────────────────────────────────────

model PricingTier {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String          @map("merchant_id") @db.Uuid
  name            String          @db.VarChar(100)
  type            PricingTierKind
  baseDiscountPct Decimal?        @map("base_discount_pct") @db.Decimal(5, 2)
  isDefault       Boolean         @default(false) @map("is_default")
  minOrderAmount  Decimal?        @map("min_order_amount") @db.Decimal(15, 2)
  conditionsJson  Json?           @map("conditions_json")
  priority        Int             @default(0)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant      Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  overrides     PricingTierOverride[]
  relationships MerchantBuyerRelationship[]

  @@index([merchantId, isActive])
  @@map("pricing_tiers")
}

model PricingTierOverride {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pricingTierId    String   @map("pricing_tier_id") @db.Uuid
  shopifyProductId String   @map("shopify_product_id") @db.VarChar(100)
  shopifyVariantId String?  @map("shopify_variant_id") @db.VarChar(100)
  price            Decimal  @db.Decimal(15, 2)
  compareAtPrice   Decimal? @map("compare_at_price") @db.Decimal(15, 2)
  currency         String   @default("USD") @db.Char(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pricingTier PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)

  // Unique (pricing_tier_id, shopify_product_id, COALESCE(shopify_variant_id,''))
  // is created in migrations/001_extensions.sql.
  @@index([pricingTierId])
  @@map("pricing_tier_overrides")
}

// ──────────────────────────────────────────────────────────────────────
// Orders & invoicing
// ──────────────────────────────────────────────────────────────────────

model Order {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId          String          @map("merchant_id") @db.Uuid
  buyerId             String          @map("buyer_id") @db.Uuid
  shopifyOrderId      String?         @unique @map("shopify_order_id") @db.VarChar(100)
  shopifyOrderNumber  String?         @map("shopify_order_number") @db.VarChar(50)
  subtotal            Decimal         @db.Decimal(15, 2)
  taxAmount           Decimal         @default(0) @map("tax_amount") @db.Decimal(15, 2)
  shippingAmount      Decimal         @default(0) @map("shipping_amount") @db.Decimal(15, 2)
  total               Decimal         @db.Decimal(15, 2)
  currency            String          @default("USD") @db.Char(3)
  paymentTerms        PaymentTerms?   @map("payment_terms")
  dueDate             DateTime?       @map("due_date") @db.Timestamptz(6)
  status              OrderStatus     @default(pending)
  syncStatus          OrderSyncStatus @default(sync_pending) @map("sync_status")
  pricingTierIdAtOrder String?        @map("pricing_tier_id_at_order") @db.Uuid
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant  Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  buyer     Buyer           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  lineItems OrderLineItem[]
  invoice   Invoice?

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, status])
  @@index([buyerId])
  @@index([buyerId, merchantId])
  @@map("orders")
}

model OrderLineItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  shopifyVariantId String?  @map("shopify_variant_id") @db.VarChar(100)
  shopifyProductId String?  @map("shopify_product_id") @db.VarChar(100)
  productTitle     String   @map("product_title") @db.VarChar(255)
  variantTitle     String?  @map("variant_title") @db.VarChar(255)
  sku              String?  @db.VarChar(100)
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(15, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(15, 2)
  appliedTierType  String?  @map("applied_tier_type") @db.VarChar(50)
  discountPct      Decimal? @map("discount_pct") @db.Decimal(5, 2)
  currency         String   @default("USD") @db.Char(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_line_items")
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  merchantId    String        @map("merchant_id") @db.Uuid
  buyerId       String        @map("buyer_id") @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate   DateTime      @map("invoice_date") @db.Timestamptz(6)
  dueDate       DateTime      @map("due_date") @db.Timestamptz(6)
  subtotal      Decimal       @db.Decimal(15, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  total         Decimal       @db.Decimal(15, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(15, 2)
  currency      String        @default("USD") @db.Char(3)
  status        InvoiceStatus @default(draft)
  pdfS3Key      String?       @map("pdf_s3_key") @db.Text
  pdfSha256     String?       @map("pdf_sha256") @db.VarChar(64)
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(6)
  firstViewedAt DateTime?     @map("first_viewed_at") @db.Timestamptz(6)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason    String?       @map("void_reason") @db.Text
  reminderCount Int           @default(0) @map("reminder_count")
  lastReminderAt DateTime?    @map("last_reminder_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  buyer    Buyer    @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([merchantId, status])
  @@index([dueDate])
  @@index([merchantId, dueDate])
  @@map("invoices")
}

// ──────────────────────────────────────────────────────────────────────
// Onboarding / registration
// ──────────────────────────────────────────────────────────────────────

model BuyerRegistrationApplication {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId           String             @map("merchant_id") @db.Uuid
  email                String             @db.VarChar(255)
  companyName          String             @map("company_name") @db.VarChar(255)
  businessType         String?            @map("business_type") @db.VarChar(100)
  website              String?            @db.VarChar(255)
  taxId                String?            @map("tax_id") @db.VarChar(100)
  phone                String?            @db.VarChar(50)
  estimatedMonthlyOrder String?           @map("estimated_monthly_order") @db.VarChar(100)
  message              String?            @db.Text
  status               RegistrationStatus @default(pending)
  reviewedBy           String?            @map("reviewed_by") @db.Uuid
  rejectionReason      String?            @map("rejection_reason") @db.Text
  reviewedAt           DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  ipAddress            String?            @map("ip_address") @db.VarChar(45)
  userAgent            String?            @map("user_agent") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  reviewer MerchantUser? @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
  @@index([merchantId, email])
  @@map("buyer_registration_applications")
}

// ──────────────────────────────────────────────────────────────────────
// Webhooks & idempotency
// ──────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopifyDomain    String        @map("shopify_domain") @db.VarChar(255)
  topic            String        @db.VarChar(100)
  shopifyEventId   String        @map("shopify_event_id") @db.VarChar(255)
  shopifyCreatedAt DateTime?     @map("shopify_created_at") @db.Timestamptz(6)
  payloadHash      String?       @map("payload_hash") @db.VarChar(64)
  // Raw webhook body, persisted durably so BullMQ workers can re-read it (the
  // job payload carries only ids). Postgres rather than REDIS_CACHE because the
  // cache is allkeys-lru and would evict in-flight payloads. Added in Prompt 2.
  payloadJson      Json?         @map("payload_json")
  status           WebhookStatus @default(pending)
  attemptCount     Int           @default(0) @map("attempt_count")
  lastError        String?       @map("last_error") @db.Text
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(6)
  workerJobId      String?       @map("worker_job_id") @db.VarChar(255)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([shopifyDomain, shopifyEventId])
  @@index([status, createdAt])
  @@index([shopifyDomain, topic, createdAt(sort: Desc)])
  @@map("webhook_events")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String   @unique @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ──────────────────────────────────────────────────────────────────────
// Audit (append-only — enforced by trigger in migrations/002)
// ──────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String?        @map("merchant_id") @db.Uuid
  correlationId String?        @map("correlation_id") @db.Uuid
  entityType    String         @map("entity_type") @db.VarChar(50)
  entityId      String         @map("entity_id") @db.Uuid
  action        String         @db.VarChar(50)
  actorId       String?        @map("actor_id") @db.Uuid
  actorType     AuditActorType @map("actor_type")
  oldValueJson  Json?          @map("old_value_json")
  newValueJson  Json?          @map("new_value_json")
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  userAgent     String?        @map("user_agent") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_log")
}
